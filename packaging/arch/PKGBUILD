# Maintainer: hakergeniusz <hakergeniusz@users.noreply.github.com>
# Verified arches: x86_64 and aarch64, both built natively (CI builds
# aarch64 in an Arch Linux ARM chroot on an arm runner)
pkgname=frame
pkgver=1.0.0
pkgrel=1
pkgdesc="Independent keyboard-driven media player"
arch=(x86_64 aarch64)
url="https://github.com/hakergeniusz/Frame"
license=(MIT)
depends=(gtk4 libadwaita mpv)
makedepends=(cargo)
checkdepends=()
optdepends=('xdg-desktop-portal: file dialogs and screensaver inhibit under sandboxing')
source=("$pkgname-$pkgver.tar.gz::https://github.com/hakergeniusz/Frame/archive/refs/tags/v$pkgver/$pkgname-$pkgver.tar.gz")
# sha256 of the v1.0.0 tag archive as served by codeload (verified
# byte-stable across repeated authenticated downloads while the repo was
# private; regenerate with `updpkgsums` if the tag ever moves — a tarball's
# hash cannot include itself, so this pin necessarily postdates the tag).
sha256sums=('a60d0a85c78e80730964c26f430a023db5e427227d8bdd278e967ba5d6be8005')

prepare() {
  # GitHub archives tags under the repository name (Frame-1.0.0/), while
  # the package tree is frame-$pkgver everywhere else — and the CI build
  # script stages exactly that name, where this rename is a no-op.
  mv -T "Frame-$pkgver" "$pkgname-$pkgver" 2>/dev/null || true
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/frame "$pkgdir/usr/bin/frame"

  _app=io.github.hakergeniusz.Frame
  install -Dm644 "assets/$_app.desktop" \
    "$pkgdir/usr/share/applications/$_app.desktop"
  install -Dm644 "assets/$_app.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/$_app.metainfo.xml"

  for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
    install -Dm644 "assets/icons/$size/apps/$_app.png" \
      "$pkgdir/usr/share/icons/hicolor/$size/apps/$_app.png"
  done
  install -Dm644 "assets/icons/scalable/apps/$_app.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_app.svg"
  install -Dm644 "assets/icons/scalable/actions/frame-ab-loop-symbolic.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/actions/frame-ab-loop-symbolic.svg"
  install -Dm644 "assets/icons/scalable/actions/frame-chapters-symbolic.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/actions/frame-chapters-symbolic.svg"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
